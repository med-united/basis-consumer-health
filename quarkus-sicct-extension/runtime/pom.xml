<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.servicehealtherx</groupId>
        <artifactId>quarkus-sicct-extension-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>quarkus-sicct-extension</artifactId>
    <name>Basis Consumer :: SICCT Quarkus Extension (Runtime)</name>
    <description>Runtime for the SICCT Quarkus extension: SicctTerminalManager, connection pool, card event router, JMX management beans, SmallRye Health check</description>

    <dependencies>
        <!-- Internal: sicct-lib for SICCT ASN.1 codec and CardTerminal entity -->
        <dependency>
            <groupId>de.servicehealtherx</groupId>
            <artifactId>sicct-lib</artifactId>
        </dependency>

        <!-- Quarkus extension runtime support -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health</artifactId>
        </dependency>

        <!-- JPA for CardTerminal entity persistence -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm-panache</artifactId>
        </dependency>

        <!-- Netty for SICCT TCP/IP client channel pool and UDP discovery -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-all</artifactId>
        </dependency>

        <!-- Quarkus scheduler for periodic SICCT service discovery -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-scheduler</artifactId>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5-mockito</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <!--
                Integration tests that require a live SICCT card terminal.
                Activate with: mvn verify -Pit [-Dsicct.it.host=...] [-Dsicct.it.port=...]
                Defaults: host=192.168.100.90, port=3001
            -->
            <id>it</id>
            <dependencies>
                <dependency>
                    <groupId>org.awaitility</groupId>
                    <artifactId>awaitility</artifactId>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>add-it-sources</id>
                                <phase>generate-test-sources</phase>
                                <goals><goal>add-test-source</goal></goals>
                                <configuration>
                                    <sources>
                                        <source>src/it/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                            <execution>
                                <id>add-it-resources</id>
                                <phase>generate-test-resources</phase>
                                <goals><goal>add-test-resource</goal></goals>
                                <configuration>
                                    <resources>
                                        <resource>
                                            <directory>src/it/resources</directory>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <sicct.it.host>${sicct.it.host}</sicct.it.host>
                                <sicct.it.port>${sicct.it.port}</sicct.it.port>
                                <sicct.it.connectTimeoutMs>${sicct.it.connectTimeoutMs}</sicct.it.connectTimeoutMs>
                            </systemPropertyVariables>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
            <properties>
                <sicct.it.host>192.168.100.90</sicct.it.host>
                <sicct.it.port>3001</sicct.it.port>
                <sicct.it.connectTimeoutMs>10000</sicct.it.connectTimeoutMs>
            </properties>
        </profile>
    </profiles>

</project>
