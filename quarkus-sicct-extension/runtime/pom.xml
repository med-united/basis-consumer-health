<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.servicehealtherx</groupId>
        <artifactId>quarkus-sicct-extension-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>quarkus-sicct-extension</artifactId>
    <name>Basis Consumer :: SICCT Quarkus Extension (Runtime)</name>
    <description>Runtime for the SICCT Quarkus extension: SicctTerminalManager, connection pool, card event router, JMX management beans, SmallRye Health check</description>

    <dependencies>
        <!-- Internal: sicct-lib for SICCT ASN.1 codec and CardTerminal entity -->
        <dependency>
            <groupId>de.servicehealtherx</groupId>
            <artifactId>sicct-lib</artifactId>
        </dependency>

        <!-- Quarkus extension runtime support -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health</artifactId>
        </dependency>

        <!-- JPA for CardTerminal entity persistence -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm-panache</artifactId>
        </dependency>

        <!-- Netty for SICCT TCP/IP client channel pool -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-all</artifactId>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
