@startuml component
title Basis Consumer — Component Diagram (Maven Modules)
skinparam componentStyle rectangle

' ── Git Submodules ──────────────────────────────────────────────────
package "api-telematik\n(git submodule: med-united/api-telematik)" {
  [conn/ WSDLs\nCertificateService · EncryptionService · SignatureService] as CONN_WSDL
  [consumer/ WSDLs\nAuthSig · Card · CardTerminal · Cert · Enc · Event · Sig\n+ ServiceDirectory.xsd] as CONS_WSDL
}

package "openkim-server\n(git submodule: sberg-net/openkim)" {
  [KimSmtpServer\n(port 25/587)] as SMTP
  [KimPop3Server\n(port 110/995)] as POP3
  [KimMessageProcessor\n(S/MIME: encrypt + sign)] as KIM_MSG
}

' ── crypto-lib ─────────────────────────────────────────────────────
package "crypto-lib\n(gemLibPki@4.0.2 · incl. Bouncy Castle)" {
  [TslDownloader\n(auto-update trust list)] as TSL
  [CertificateParser\n(RegNr · SMC-B · eHBA attributes)] as CPARS
  [TrustService\n(CDI @ApplicationScoped)] as TSVC
  interface "CryptoProvider\n(CDI interface)" as CPROV_IFACE
}

' ── crypto-p12-lib ─────────────────────────────────────────────────
package "crypto-p12-lib\n(crypto-lib)" {
  [P12CryptoProvider\n(@ApplicationScoped)] as P12PROV
}

' ── crypto-pcsc-lib ────────────────────────────────────────────────
package "crypto-pcsc-lib\n(crypto-lib)" {
  [PcscCryptoProvider\n(@ApplicationScoped)] as PCSCPROV
}

' ── crypto-sicct-lib ───────────────────────────────────────────────
package "crypto-sicct-lib\n(crypto-lib · sicct-lib)" {
  [SicctCryptoProvider\n(@ApplicationScoped)] as SICCTPROV
}

' ── sicct-lib ──────────────────────────────────────────────────────
package "sicct-lib\n(crypto-lib · javax.smartcardio · beanit jASN1 codegen)" {
  [SICCT.asn1\n→ jASN1 Generated Classes\n(Maven generate-sources)] as ASN1
  [EhealthAuthenticator\n(CREATE · VALIDATE · ADD Phase1/2)] as EAUTH
  [JceKeyStoreSPI\n(SMC-B · eHBA — APDU generation)] as KSSPI
}

' ── quarkus-sicct-extension ────────────────────────────────────────
package "quarkus-sicct-extension\n(sicct-lib · Quarkus · Netty)" {
  [SicctExtensionProcessor\n(build-time CDI registration)] as PROC
  [SicctTerminalManager\n(UDP discovery · Netty TCP client pool)] as STM
  [CardSlotTracker (@Scheduled)] as SLOT
  [SicctHealthCheck (@Readiness)] as SHCK
}

' ── crypto-services-lib ────────────────────────────────────────────
package "crypto-services-lib\n(crypto-lib · NO sicct-lib dependency)" {
  [SignatureService\n(sign · ExternalAuthenticate\nInstance<CryptoProvider>)] as SIGI
  [EncryptionService\n(encrypt · decrypt\nInstance<CryptoProvider>)] as ENCI
  [CertificateService\n(read · verify)] as CERTI
}

' ── quarkus-ldap-proxy-server-extension ────────────────────────────
package "quarkus-ldap-proxy-server-extension\n(Quarkus · Netty)" {
  [LdapServerCodec\n(port 389/636)] as LDAP_SRV
  [OperationFilter\n(Bind · Unbind · Search · Abandon)] as LDAP_FLT
  [VzdLdapClient\n(LDAPS → TI VZD)] as LDAP_CLI
}

' ── consumer-soap-server ─────────────────────────────────────
package "consumer-soap-server\n(Apache CXF · URL /consumer)" {
  [CertificateService\n(conn/CertSvc.wsdl)] as BCS_C
  [EncryptionService\n(conn/EncSvc.wsdl)] as BCS_E
  [SignatureService\n(conn/SigSvc.wsdl)] as BCS_S
  [AufrufKontextInterceptor] as BCS_AKI
  [MtomInterceptor] as BCS_MTOM
}

' ── konnektor-soap-server ──────────────────────────────────────────
package "konnektor-soap-server\n(Apache CXF · URL /conn)" {
  [AuthSignatureService] as KS_AUTH
  [CardService] as KS_CARD
  [CardTerminalService] as KS_CT
  [CertificateService] as KS_CERT
  [EncryptionService] as KS_ENC
  [EventService] as KS_EVT
  [SignatureService] as KS_SIG
  [connector.sds\n(ServiceDirectory.xsd)] as KS_SDS
  [AufrufKontextInterceptor] as KS_AKI
}

' ── Intra-module wiring ────────────────────────────────────────────
TSL --> TSVC
CPARS --> TSVC
ASN1 --> EAUTH
KSSPI --> EAUTH
PROC --> STM
STM --> SLOT
SHCK --> STM
LDAP_SRV --> LDAP_FLT
LDAP_FLT --> LDAP_CLI
BCS_AKI --> BCS_C
BCS_AKI --> BCS_E
BCS_AKI --> BCS_S
BCS_MTOM --> BCS_E
BCS_MTOM --> BCS_S
KS_AKI --> KS_AUTH
KS_AKI --> KS_CARD
KS_AKI --> KS_CT
KS_AKI --> KS_CERT
KS_AKI --> KS_ENC
KS_AKI --> KS_SIG
SMTP --> KIM_MSG
POP3 --> KIM_MSG

' ── Provider implementations → CryptoProvider interface ───────────
P12PROV ..|> CPROV_IFACE
PCSCPROV ..|> CPROV_IFACE
SICCTPROV ..|> CPROV_IFACE

' ── Cross-module dependencies ─────────────────────────────────────
' sicct-lib → crypto-lib
EAUTH ..> TSVC : cert validation
KSSPI ..> CPARS : SAK.AUT cert parsing

' quarkus-sicct-extension → sicct-lib
STM ..> EAUTH : EHEALTH AUTHENTICATE
STM ..> KSSPI : card slot access

' crypto-sicct-lib → sicct-lib
SICCTPROV ..> STM : terminal access

' crypto-services-lib → crypto-lib (via Instance<CryptoProvider>)
SIGI ..> CPROV_IFACE : Instance<CryptoProvider>
ENCI ..> CPROV_IFACE : Instance<CryptoProvider>
CERTI ..> CPARS

' api-telematik WSDLs → SOAP servers (CXF wsdl2java)
CONN_WSDL ..> BCS_C : wsdl2java
CONN_WSDL ..> BCS_E : wsdl2java
CONN_WSDL ..> BCS_S : wsdl2java
CONS_WSDL ..> KS_AUTH : wsdl2java
CONS_WSDL ..> KS_CARD : wsdl2java
CONS_WSDL ..> KS_CT : wsdl2java
CONS_WSDL ..> KS_CERT : wsdl2java
CONS_WSDL ..> KS_ENC : wsdl2java
CONS_WSDL ..> KS_EVT : wsdl2java
CONS_WSDL ..> KS_SIG : wsdl2java
CONS_WSDL ..> KS_SDS : ServiceDirectory.xsd

' consumer-soap-server → crypto-services-lib
BCS_C ..> CERTI
BCS_E ..> ENCI
BCS_S ..> SIGI

' konnektor-soap-server → crypto-services-lib + quarkus-sicct-extension
KS_CERT ..> CERTI
KS_ENC ..> ENCI
KS_SIG ..> SIGI
KS_AUTH ..> SIGI
KS_CARD ..> STM : card ops via SICCT
KS_CT ..> STM : terminal lifecycle

' openkim-server → crypto-lib
KIM_MSG ..> TSVC : sign/encrypt KIM messages

@enduml
