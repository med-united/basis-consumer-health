@startuml deployment
title Basis Consumer — Deployment Diagram (Multi-Tenant Kubernetes)

skinparam nodeStyle rectangle

node "Kubernetes Cluster" {

  node "Tenant A Namespace" <<Namespace>> {
    artifact "basis-consumer-server\n(Quarkus JVM Pod)" as BCA {
      component "konnektor-soap-server\n(Apache CXF)" as SOAPA
      component "consumer-soap-server\n(Apache CXF)" as CSOPA
      component "ldap-proxy-server\n(Netty LDAPv3)" as LDAPA
      component "sicct-extension\n(Netty TCP client)" as SICSRVA
      component "Hawtio\n(Management Console)" as HAWTIOA
      component "SmallRye Health\n(/health/ready)" as HEALTHA
    }
    artifact "openkim-server\n(Spring Boot Pod)" as OPENKIMA
    database "JavaDB (JPA)\nCardTerminalRecord · AuditLog" as DBA
  }

  node "Tenant B Namespace" <<Namespace>> {
    artifact "basis-consumer-server\n(Quarkus JVM Pod)" as BCB
    artifact "openkim-server\n(Spring Boot Pod)" as OPENKIMB
    database "JavaDB (JPA)" as DBB
  }

}

node "SZZP\n(Sicherer Zugangspunkt zur TI)" <<Router>> as SZZP

node "TI Network" {
  node "TI VZD\n(LDAPS :636)" as VZD
  node "KIM-Fachdienst\n(SMTP / POP3)" as KIMSRV
  node "TI DNS / KSR / NTP" as DNS
}

node "Physical Infrastructure" {
  node "HSM\n(FIPS 140-2 Level 3)" as HSM
  node "PC/SC USB Card Readers" as PCSC
}

node "Primärsystem Network (LAN)" {
  node "PVS / KIS / AVS\n(SOAP client)" as PVS
  node "Mail Client\n(SMTP / POP3)" as MAIL
  node "SICCT Card Terminals\n(TCP/IP, SICCT V1.3.0)" as KT
}

' Tenant A internal
BCA --> DBA : JPA / JDBC
BCA --> OPENKIMA : KIM delegation\n(SMTP / POP3)

' Tenant A to physical
BCA --> HSM : PKCS#11 (SunPKCS11)
BCA --> PCSC : javax.smartcardio\n(pcscd)
BCA --> KT : Mutual TLS\n(SICCT over TCP)

' Tenant A to TI via SZZP
BCA --> SZZP : TLS
OPENKIMA --> SZZP : SMTP / POP3

SZZP --> VZD : LDAPS
SZZP --> KIMSRV : SMTP / POP3
SZZP --> DNS : DNS-SD / HTTPS / NTP

' Client systems to Tenant A
PVS --> BCA : SOAP / TLS\n(Konnektor WSDL)
MAIL --> OPENKIMA : SMTP / POP3

' Tenant B (abbreviated)
BCB --> DBB : JPA / JDBC
BCB --> OPENKIMB : KIM delegation
BCB --> HSM : PKCS#11
BCB --> KT : Mutual TLS

@enduml
