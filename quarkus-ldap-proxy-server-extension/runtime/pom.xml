<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.servicehealtherx</groupId>
        <artifactId>quarkus-ldap-proxy-server-extension-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>quarkus-ldap-proxy-server-extension</artifactId>
    <name>Basis Consumer :: LDAP Proxy Server Quarkus Extension (Runtime)</name>
    <description>Runtime for the LDAP proxy server extension: Netty 4 LDAP server pipeline, TI DNS-SD discovery, LDAPS upstream proxy, DnsServiceDiscoveryManagement JMX bean</description>

    <dependencies>
        <!-- Internal: crypto-lib for mTLS certificate handling -->
        <dependency>
            <groupId>de.servicehealtherx</groupId>
            <artifactId>crypto-lib</artifactId>
        </dependency>

        <!-- Quarkus CDI + Health -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health</artifactId>
        </dependency>

        <!-- Netty for LDAP server pipeline -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-all</artifactId>
        </dependency>

        <!-- UnboundID LDAP SDK for protocol parsing -->
        <dependency>
            <groupId>com.unboundid</groupId>
            <artifactId>unboundid-ldapsdk</artifactId>
            <version>7.0.1</version>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
